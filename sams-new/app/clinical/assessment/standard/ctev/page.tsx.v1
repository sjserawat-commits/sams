"use client";

import Link from "next/link";
import { useMemo, useState } from "react";

type Score = 0 | 0.5 | 1;

const piraniItems = [
  {
    group: "Midfoot",
    name: "Curved lateral border",
    description: "Assessment of the lateral border/forefoot adduction.",
  },
  {
    group: "Midfoot",
    name: "Medial crease",
    description: "Depth and prominence of the medial crease.",
  },
  {
    group: "Midfoot",
    name: "Lateral head of talus",
    description: "Palpability and coverage of the lateral talar head.",
  },
  {
    group: "Hindfoot",
    name: "Posterior crease",
    description: "Depth and prominence of the posterior heel crease.",
  },
  {
    group: "Hindfoot",
    name: "Empty heel",
    description: "Assessment of the palpable heel pad/empty heel.",
  },
  {
    group: "Hindfoot",
    name: "Equinus",
    description: "Correctability of the equinus deformity.",
  },
];

const options: { value: Score; label: string }[] = [
  { value: 0, label: "0 — Normal / corrected" },
  { value: 0.5, label: "0.5 — Moderate" },
  { value: 1, label: "1 — Severe" },
];

export default function CTEVAssessmentPage() {
  const [scores, setScores] = useState<Record<string, Score>>({});
  const [side, setSide] = useState<"Right" | "Left">("Right");

  const total = useMemo(
    () => Object.values(scores).reduce((sum, value) => sum + value, 0),
    [scores]
  );

  const completed = Object.keys(scores).length;
  const severity =
    total <= 1.5
      ? "Mild"
      : total <= 3
        ? "Moderate"
        : total <= 4.5
          ? "Moderate–Severe"
          : "Severe";

  function setScore(name: string, value: Score) {
    setScores((current) => ({ ...current, [name]: value }));
  }

  return (
    <main className="min-h-screen bg-slate-50 p-5 sm:p-7">
      <div className="mx-auto max-w-6xl">

        <section className="rounded-3xl bg-[#082b61] p-7 text-white shadow-lg sm:p-9">
          <div className="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <span className="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-blue-100">
                CTEV / Clubfoot
              </span>

              <h1 className="mt-4 text-3xl font-black tracking-tight sm:text-4xl">
                Pirani Score
              </h1>

              <p className="mt-3 max-w-2xl text-sm leading-6 text-blue-100">
                Structured clinical assessment of congenital talipes
                equinovarus with automatic score calculation.
              </p>
            </div>

            <Link
              href="/clinical/assessment/standard"
              className="w-fit rounded-xl border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-semibold hover:bg-white/20"
            >
              ← Standard Assessments
            </Link>
          </div>
        </section>

        <div className="mt-7 grid gap-6 lg:grid-cols-[1fr_290px]">

          <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">

            <div className="flex flex-col gap-4 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
              <div>
                <p className="text-xs font-semibold uppercase tracking-wider text-blue-600">
                  Examination
                </p>
                <h2 className="mt-1 text-xl font-bold text-slate-900">
                  Pirani Clinical Signs
                </h2>
              </div>

              <div className="flex rounded-xl bg-slate-100 p-1">
                {(["Right", "Left"] as const).map((value) => (
                  <button
                    key={value}
                    type="button"
                    onClick={() => {
                      setSide(value);
                      setScores({});
                    }}
                    className={`rounded-lg px-4 py-2 text-sm font-semibold transition ${
                      side === value
                        ? "bg-white text-[#082b61] shadow-sm"
                        : "text-slate-500"
                    }`}
                  >
                    {value}
                  </button>
                ))}
              </div>
            </div>

            <div className="divide-y divide-slate-100">
              {["Midfoot", "Hindfoot"].map((group) => (
                <div key={group} className="p-6 sm:p-8">
                  <h3 className="mb-4 text-sm font-bold uppercase tracking-wider text-slate-400">
                    {group}
                  </h3>

                  <div className="space-y-5">
                    {piraniItems
                      .filter((item) => item.group === group)
                      .map((item) => (
                        <div
                          key={item.name}
                          className="rounded-2xl border border-slate-200 p-5"
                        >
                          <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                            <div>
                              <h4 className="font-bold text-slate-900">
                                {item.name}
                              </h4>
                              <p className="mt-1 text-sm text-slate-500">
                                {item.description}
                              </p>
                            </div>

                            <div className="flex flex-wrap gap-2">
                              {options.map((option) => (
                                <button
                                  key={option.value}
                                  type="button"
                                  onClick={() =>
                                    setScore(item.name, option.value)
                                  }
                                  className={`rounded-xl border px-3 py-2 text-xs font-semibold transition ${
                                    scores[item.name] === option.value
                                      ? "border-blue-600 bg-blue-600 text-white"
                                      : "border-slate-200 bg-white text-slate-600 hover:bg-slate-50"
                                  }`}
                                >
                                  {option.label}
                                </button>
                              ))}
                            </div>
                          </div>
                        </div>
                      ))}
                  </div>
                </div>
              ))}
            </div>

            <div className="border-t border-slate-200 px-6 py-5 sm:px-8">
              <div className="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <button
                  type="button"
                  className="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50"
                >
                  Save Draft
                </button>

                <button
                  type="button"
                  disabled={completed !== 6}
                  className="rounded-xl bg-[#082b61] px-5 py-2.5 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40"
                >
                  Save Assessment
                </button>
              </div>
            </div>
          </section>

          <aside className="h-fit rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:sticky lg:top-6">
            <p className="text-xs font-semibold uppercase tracking-wider text-blue-600">
              {side} Foot
            </p>

            <p className="mt-2 text-sm font-medium text-slate-500">
              Pirani Total Score
            </p>

            <div className="mt-3 flex items-end gap-2">
              <span className="text-5xl font-black text-[#082b61]">
                {total}
              </span>
              <span className="pb-1 text-lg font-semibold text-slate-400">
                / 6
              </span>
            </div>

            <div className="mt-5 h-2 overflow-hidden rounded-full bg-slate-100">
              <div
                className="h-full rounded-full bg-blue-600 transition-all"
                style={{ width: `${(total / 6) * 100}%` }}
              />
            </div>

            <div className="mt-6 rounded-xl bg-slate-50 p-4">
              <p className="text-xs font-semibold uppercase tracking-wider text-slate-400">
                Current interpretation
              </p>
              <p className="mt-1 text-lg font-bold text-slate-800">
                {severity}
              </p>
            </div>

            <div className="mt-5 border-t border-slate-100 pt-5">
              <div className="flex justify-between text-sm">
                <span className="text-slate-500">Completed signs</span>
                <span className="font-bold text-slate-800">
                  {completed} / 6
                </span>
              </div>
            </div>

            <div className="mt-6 rounded-xl border border-blue-100 bg-blue-50 p-4">
              <p className="text-xs leading-5 text-slate-600">
                Scores are recorded separately for each foot so right and
                left-sided assessments can be followed independently.
              </p>
            </div>
          </aside>

        </div>
      </div>
    </main>
  );
}
