generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Patient {
  opdVisits        OPDVisit[]
  encounters       ClinicalEncounter[]
  billingRecords   BillingRecord[]
  id               Int      @id @default(autoincrement())
  patientId        String   @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  gender           String?
  phone            String?
  aadhaarNumber    String?
  address          String?
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Appointment {
  id             Int      @id @default(autoincrement())
  appointmentNo  String   @unique
  patientId      Int?
  patientType    String   @default("NEW")
  patientName    String
  mobile         String
  dob            DateTime?
  gender         String?
  email          String?
  reason         String?
  departmentId   Int?
  departmentName String?
  doctorId       Int?
  doctorName     String
  appointmentDate String
  appointmentTime String
  source         String   @default("ONLINE")
  status         String   @default("SCHEDULED")
  opdVisitId     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClinicalEncounter {
  opdVisitId     Int?      @unique
  opdVisit       OPDVisit? @relation(fields: [opdVisitId], references: [id])
  id             Int       @id @default(autoincrement())
  patientId      Int
  encounterDate  DateTime  @default(now())
  speciality     String?
  chiefComplaint String?
  diagnosis      String?
  clinicalNotes  String?
  treatmentPlan  String?
  followUpDate   DateTime?
  assessmentData String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  code      String     @unique
  active    Boolean    @default(true)
  doctors   Doctor[]
  opdVisits OPDVisit[] @relation("DepartmentVisits")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Doctor {
  id            Int         @id @default(autoincrement())
  name          String
  qualification String?
  introduction String?
  photoUrl      String?
  departmentId  Int?
  active        Boolean     @default(true)
  department    Department? @relation(fields: [departmentId], references: [id])
  opdVisits     OPDVisit[]  @relation("DoctorVisits")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OPDVisit {
  clinicalEncounter   ClinicalEncounter?
  investigationOrders InvestigationOrder[]
  prescriptions       Prescription[]
  billingRecords      BillingRecord[]
  billingLineItems    BillingLineItem[]
  id                  Int                  @id @default(autoincrement())
  patientId           Int
  tokenNumber         Int
  visitType            String               @default("NEW")
  status              String               @default("WAITING")
  departmentId        Int?
  departmentMaster    Department?          @relation("DepartmentVisits", fields: [departmentId], references: [id])
  doctorId            Int?
  doctor              Doctor?              @relation("DoctorVisits", fields: [doctorId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  patient              Patient              @relation(fields: [patientId], references: [id])
}

model InvestigationMaster {
  id                     Int      @id @default(autoincrement())
  code                   String   @unique
  name                   String
  shortName              String?
  category               String
  department             String?
  specimen               String?
  method                 String?
  unit                   String?
  referenceRange         String?
  maleReferenceRange     String?
  femaleReferenceRange   String?
  ageSpecificRange       String?
  criticalValue          String?
  smsLabDepartment       String?
  aliases                String?
  rate                   Float    @default(0)
  smsBenchmarkRate       Float?
  corporateBenchmarkRate Float?
  pricingLastVerifiedAt  DateTime?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  orders                 InvestigationOrder[]
}

model InvestigationOrder {
  id              Int       @id @default(autoincrement())
  opdVisitId      Int
  investigationId Int?
  investigation   String
  price           Float
  discountType    String?
  discountValue   Float     @default(0)
  netAmount       Float
  paymentStatus   String    @default("UNPAID")
  paymentMethod   String?
  receiptNumber   String?
  paidAt          DateTime?
  status          String    @default("ORDERED")
  reportText      String?
  reportedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  opdVisit        OPDVisit  @relation(fields: [opdVisitId], references: [id])
  master          InvestigationMaster? @relation(fields: [investigationId], references: [id])
}

model Prescription {
  id            Int      @id @default(autoincrement())
  opdVisitId    Int
  medicineName  String
  dose          String?
  frequency     String?
  duration      String?
  instructions  String?
  quantity      Int      @default(1)
  unitPrice     Float    @default(0)
  billingStatus String   @default("UNBILLED")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  opdVisit       OPDVisit @relation(fields: [opdVisitId], references: [id])
}

model BillingRecord {
  id            Int               @id @default(autoincrement())
  billNumber    String            @unique
  receiptNumber String?           @unique
  patientId     Int
  opdVisitId    Int?
  subtotal      Float             @default(0)
  discount      Float             @default(0)
  netAmount     Float             @default(0)
  paymentStatus String             @default("UNPAID")
  paymentMethod String?
  paidAmount    Float             @default(0)
  balanceAmount Float             @default(0)
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  patient       Patient           @relation(fields: [patientId], references: [id])
  opdVisit      OPDVisit?         @relation(fields: [opdVisitId], references: [id])
  lineItems     BillingLineItem[]
}

model BillingLineItem {
  id              Int            @id @default(autoincrement())
  billingRecordId Int?
  opdVisitId      Int
  serviceType     String
  description     String
  quantity        Float          @default(1)
  unitPrice       Float          @default(0)
  amount          Float          @default(0)
  sourceType      String?
  sourceId        Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  billingRecord   BillingRecord? @relation(fields: [billingRecordId], references: [id], onDelete: Cascade)
  opdVisit        OPDVisit       @relation(fields: [opdVisitId], references: [id])
}
